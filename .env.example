# Docker Compose reads this file automatically.
TZ=Europe/London
KOBO_DATA_DIR=/data
KOBO_PAPER_TITLE=The Morning Paper
KOBO_PAPER_TAGLINE=All the Reads Worth Your Time
KOBO_MAX_AGE_DAYS=7
KOBO_SOURCE_INGEST_DIR= # defaults to $KOBO_DATA_DIR/source-ingest
KOBO_SOURCE_ARCHIVE_DIR= # defaults to $KOBO_DATA_DIR/source-archive
# Comma-separated paths inside the container. Leave empty to keep the EPUB in KOBO_DATA_DIR.
KOBO_OUTPUT_INGEST_DIRS=
KOBO_FONTS_DIR=fonts
KOBO_MASTHEAD_FONT=UnifrakturMaguntia-Book.ttf
KOBO_SERIF_BOLD_FONT=PT_Serif-Web-Bold.ttf
KOBO_SERIF_REGULAR_FONT=PT_Serif-Web-Regular.ttf
KOBO_LEAD_IMAGE_AVOID_FACES=true
KOBO_SCHEDULE_TIME=03:00
KOBO_SCHEDULER_RETRY_MINUTES=15
KOBO_SCHEDULER_POLL_SECONDS=20
