# Edit the paths, then add these lines to your cron table with `crontab -e`.
PATH=/usr/local/bin:/usr/bin:/bin
REPO=/path/to/kobo-morning-paper
PY=/path/to/kobo-morning-paper/.venv/bin/python
KOBO_PAPER_CONFIG=/path/to/kobo-morning-paper/config.json

# 3:00 AM  collect source files, build the daily newspaper, publish and archive the batch
0 3 * * * $PY $REPO/scripts/kobo-ingest-build.py >> $HOME/kobo-articles/cron.log 2>&1

# Optional: refresh the interest model separately (does not run the source-file ingest).
# 15 2 * * * $PY $REPO/scripts/kobo-interests.py >> $HOME/kobo-articles/interests.log 2>&1
